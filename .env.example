# --------------------------- Personal JobHunt ----------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
SCREEN_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.6-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# ---------------------------- Instagram -------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v26.0

# Public image hosting used by Instagram publishing
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=daily-it-jobs

# ---------------------- Instagram comment automation ------------------
# true = process comments; false = receive/log but send nothing
INSTAGRAM_COMMENT_AUTOMATION_ENABLED=true
# any = every comment on a published job post triggers; keyword = match keyword
INSTAGRAM_COMMENT_TRIGGER_MODE=any
INSTAGRAM_COMMENT_KEYWORD=LINK
INSTAGRAM_PRIVATE_REPLY_ENABLED=true
INSTAGRAM_PUBLIC_REPLY_ENABLED=false
INSTAGRAM_PRIVATE_REPLY_TEMPLATE=Hi! 👋\n\nHere is the official application link for this job:\n\n{url}\n\nPlease verify the details on the official company career page before applying.
INSTAGRAM_PUBLIC_REPLY_TEMPLATE=📩 Check your messages — I've sent the official application link!

# Meta webhook verification / security
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_TO_A_RANDOM_VALUE
# Turn on after you add META_APP_SECRET locally
INSTAGRAM_WEBHOOK_VERIFY_SIGNATURE=false
META_APP_SECRET=
INSTAGRAM_WEBHOOK_HOST=0.0.0.0
INSTAGRAM_WEBHOOK_PORT=8000
INSTAGRAM_WEBHOOK_LOG_FILE=out/instagram_webhook.log
INSTAGRAM_WEBHOOK_DB=instagram_webhook.sqlite3
INSTAGRAM_POSTS_MANIFEST=out/channel/posts.json

# ----------------------------- WhatsApp --------------------------------
# WhatsApp Business Cloud API only; this is not a group/channel poster.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
